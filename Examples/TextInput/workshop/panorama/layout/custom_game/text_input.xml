<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/hud_shared.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/text_input.vcss_c" />
	</styles>

	<!--
		Layout for the TextInput example.

		The point of it is the big readout below: a layout cannot accept a keystroke - only Panel,
		Label, Image and Button are allowed and there are no scripts - so the text arrives through
		chat and the server writes it into {s:input_value}. Showing it back prominently is what makes
		that indirection feel like an input box rather than a trick.

		The shell comes from hud_shared. Everything here is either the readout or a 4-row pool.

		DRIVEN BY:
		  menu_title / menu_subtitle   {s:}   - header
		  input_value                  {s:}   - what the player typed, echoed by PromptText
		  row{n}                       hidden - unused rows collapse
		  row{n}_title / row{n}_sub    {s:}   - row text
		  row{n}_btn                   click  - MenuItem.OnSelect
		  menu_close                   click  - closes
		  menu_footer                  {s:}   - status line
	-->
	<Panel class="hud-screen" hittest="false">
		<Panel id="HudMenuRoot" class="hud-root hud-card ti-root">

			<Panel class="hud-head">
				<Label class="hud-title" text="{s:menu_title}" />
				<Label class="hud-tag" text="{s:menu_subtitle}" />
				<Button id="menu_close" class="hud-exit">
					<Label class="hud-x" text="&#x2715;" />
				</Button>
			</Panel>

			<Panel class="ti-body">

				<Label class="ti-caption" text="Current value" />

				<Panel class="ti-readout">
					<Label class="ti-value" text="{s:input_value}" />
				</Panel>

				<Panel class="ti-rows">
				<Panel id="row0" class="ti-row hidden">
					<Button id="row0_btn" class="ti-row-hit">
						<Label class="ti-row-title" text="{s:row0_title}" />
						<Label class="ti-row-sub" text="{s:row0_sub}" />
					</Button>
				</Panel>
				<Panel id="row1" class="ti-row hidden">
					<Button id="row1_btn" class="ti-row-hit">
						<Label class="ti-row-title" text="{s:row1_title}" />
						<Label class="ti-row-sub" text="{s:row1_sub}" />
					</Button>
				</Panel>
				<Panel id="row2" class="ti-row hidden">
					<Button id="row2_btn" class="ti-row-hit">
						<Label class="ti-row-title" text="{s:row2_title}" />
						<Label class="ti-row-sub" text="{s:row2_sub}" />
					</Button>
				</Panel>
				<Panel id="row3" class="ti-row hidden">
					<Button id="row3_btn" class="ti-row-hit">
						<Label class="ti-row-title" text="{s:row3_title}" />
						<Label class="ti-row-sub" text="{s:row3_sub}" />
					</Button>
				</Panel>
				</Panel>

			</Panel>

			<Panel class="hud-foot">
				<Label class="hud-hint" text="{s:menu_footer}" />
			</Panel>

		</Panel>
	</Panel>
</root>
