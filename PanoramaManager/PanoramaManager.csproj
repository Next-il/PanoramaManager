<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>PanoramaManager</AssemblyName>
    <RootNamespace>PanoramaManager</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>PanoramaManager</PackageId>
    <Description>Server-driven Panorama HUDs for CounterStrikeSharp. Drive a custom_hud_layout from typed C# - write text, toggle classes per player, and get clicks back - on CounterStrikeSharp's own CCSCustomHudLayout API, with no gamedata to maintain.</Description>
    <Authors>Next-il</Authors>
    <PackageTags>cs2;counter-strike;counterstrikesharp;panorama;hud;ui;menu</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Next-il/PanoramaManager</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Next-il/PanoramaManager</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Ship the .pdb separately so a stack trace from a consumer has real line numbers. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!--
      hud_shared.css is deliberately NOT packed. It is addon content that has to be compiled into a
      VPK, so a copy sitting in a consumer's bin folder would only be misleading.
    -->
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="$(CounterStrikeSharpVersion)"
                      ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
