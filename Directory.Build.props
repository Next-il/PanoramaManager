<Project>

  <PropertyGroup>
    <CounterStrikeSharpVersion>1.0.373</CounterStrikeSharpVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- CounterStrikeSharp 1.0.373 ships lib/net10.0 only. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Without these, output lands in a net10.0/ subfolder and no longer matches the
         plugins/<Name>/<Name>.dll layout CounterStrikeSharp requires. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Version>0.2.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Undocumented public members: the API surface is documented, internals are not. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="obj\**" />
    <None Remove="obj\**" />
  </ItemGroup>

</Project>
